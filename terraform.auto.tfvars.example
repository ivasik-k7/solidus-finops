# =============================================================================
# Example terraform.auto.tfvars — realistic "Run"-phase values
#
# Copy to terraform.auto.tfvars (or set in your TFE workspace variables) and
# tailor to your environment. Anything marked SENSITIVE should be a sensitive
# variable in the TFE workspace, NOT committed to git.
#
# Defaults shown here lean conservative (7-year log retention) so they're
# also valid for SOX / PCI / GDPR / DORA workloads. Trim log_retention_days
# down to 365 (or less) if you don't need long retention.
#
# Variable naming convention: every submodule variable is strictly prefixed
# with its module slug (e.g. cost_data_exports_*, tag_governance_*,
# instance_scheduler_*). Booleans use the `<module>_enabled` suffix form.
# =============================================================================

# --- Identity & naming ------------------------------------------------------
namespace   = "examplebank"
environment = "shared"
stack_name  = "finops"

# --- Regions ----------------------------------------------------------------
# Framework infrastructure (KMS, DDB, Lambdas, dashboards) lives in
# aws_primary_region. Scanning modules (idle-resource-cleanup,
# instance-scheduler) iterate across [primary] + secondaries by default.
aws_primary_region    = "eu-central-1"
aws_secondary_regions = ["us-east-1", "ap-southeast-1"]

extra_tags = {
  Project            = "finops-platform"
  TerraformWorkspace = "finops-shared"
}

# --- Encryption -------------------------------------------------------------
create_kms_key               = true
kms_key_deletion_window_days = 30

# --- Observability ----------------------------------------------------------
log_retention_days = 2557 # 7 years (SOX/PCI/GDPR). For non-regulated accounts, 365 is plenty.
lambda_runtime     = "python3.12"

# --- Alerting (the events bus) ---------------------------------------------
alerting_legacy_emails = [
  "finops-team@examplebank.com",
  "cloud-platform@examplebank.com",
]

# SENSITIVE — set in TFE workspace variables, never commit:
#   alerting_slack_webhook_url = "https://hooks.slack.com/services/..."
#   alerting_teams_webhook_url = "https://examplebank.webhook.office.com/..."

# Multi-channel alternative (preferred over the legacy single-webhook inputs):
# alerting_channels = {
#   slack = [{
#     webhook_secret_arn = "arn:aws:secretsmanager:..."
#     min_severity       = "info"
#   }]
#   pagerduty = [{
#     integration_key_secret_arn = "arn:aws:secretsmanager:..."
#     min_severity               = "high"
#   }]
# }

# --- Cost & Usage data exports ---------------------------------------------
cost_data_exports_enabled            = true
cost_data_exports_focus_enabled      = true
cost_data_exports_athena_enabled     = true
cost_data_exports_retention_days     = 90   # then tier current versions to GLACIER_IR
cost_data_exports_expiration_days    = 2555 # 7 years total (SOX/PCI)

# Cross-account FinOps tooling onboarding (e.g. Cloudability):
# cost_data_exports_cross_account_readers = [{
#   name        = "cloudability"
#   account_id  = "165761016623"
#   external_id = "<from Cloudability onboarding>"
# }]

# --- Tag governance ---------------------------------------------------------
tag_governance_enabled = true

tag_governance_required_tags = [
  { key = "CostCenter", allowed_values = [] },
  { key = "Environment", allowed_values = ["prod", "nonprod", "dr", "sandbox"] },
  { key = "Application", allowed_values = [] },
  { key = "Owner", allowed_values = [] },
  { key = "BusinessUnit", allowed_values = ["retail-banking", "investment-banking", "wealth", "corporate", "operations", "technology-shared"] },
  { key = "DataClassification", allowed_values = ["public", "internal", "confidential", "restricted"] },
]

tag_governance_drift_detection_enabled = true
tag_governance_drift_watched_keys      = ["CostCenter", "BusinessUnit", "Application"]

# Optional — dollarize the tag gap (requires cost_data_exports + Athena)
tag_governance_untagged_cost_report_enabled      = true
tag_governance_untagged_cost_alarm_threshold_usd = 5000

# --- Budgets ----------------------------------------------------------------
budgets_currency = "USD"

budgets_items = {
  account_monthly = {
    scope  = "account"
    amount = 250000
  }
  ec2_monthly = {
    scope  = "service"
    amount = 80000
    target = { service = "Amazon Elastic Compute Cloud - Compute" }
  }
  rds_monthly = {
    scope  = "service"
    amount = 40000
    target = { service = "Amazon Relational Database Service" }
  }
  s3_monthly = {
    scope  = "service"
    amount = 15000
    target = { service = "Amazon Simple Storage Service" }
  }
  lambda_monthly = {
    scope  = "service"
    amount = 5000
    target = { service = "AWS Lambda" }
  }
  opensearch_monthly = {
    scope  = "service"
    amount = 12000
    target = { service = "Amazon OpenSearch Service" }
  }
  retail_banking_monthly = {
    scope  = "tag"
    amount = 80000
    target = { tag_key = "BusinessUnit", tag_value = "retail-banking" }
  }
  investment_banking_monthly = {
    scope  = "tag"
    amount = 100000
    target = { tag_key = "BusinessUnit", tag_value = "investment-banking" }
  }
  wealth_monthly = {
    scope  = "tag"
    amount = 30000
    target = { tag_key = "BusinessUnit", tag_value = "wealth" }
  }
}

# --- Idle resource cleanup (DRY RUN ON BY DEFAULT) -------------------------
idle_cleanup_enabled               = true # default false; opt in explicitly
idle_cleanup_dry_run               = true # KEEP TRUE until you're confident
idle_cleanup_exception_tag_key     = "FinOpsException"
idle_cleanup_ebs_min_age_days      = 14
idle_cleanup_snapshot_min_age_days = 90

# --- Instance scheduler (OPT-IN BY TAG) ------------------------------------
instance_scheduler_enabled        = true # default false; opt in explicitly
instance_scheduler_opt_in_tag_key = "Schedule"

instance_scheduler_schedules = {
  "office-hours-cet" = {
    days     = ["MON", "TUE", "WED", "THU", "FRI"]
    start    = "08:00"
    stop     = "18:00"
    timezone = "Europe/Berlin"
  }
  "office-hours-est" = {
    days     = ["MON", "TUE", "WED", "THU", "FRI"]
    start    = "08:00"
    stop     = "18:00"
    timezone = "America/New_York"
  }
  "weekends-off" = {
    days     = ["MON", "TUE", "WED", "THU", "FRI"]
    start    = "00:00"
    stop     = "23:59"
    timezone = "UTC"
  }
}

# Per-module scan override. Empty (default) = framework-wide
# effective_regions = [aws_primary_region] + aws_secondary_regions.
# Set explicitly only to scope THIS module to a different region list.
# instance_scheduler_scan_regions = ["eu-central-1"]

# Resource type toggles
instance_scheduler_enable_rds_instances = true
instance_scheduler_enable_rds_clusters  = true
instance_scheduler_enable_asg           = false # opt-in; scale-to-zero is intrusive

# Blast-radius cap: hard ceiling on mutating actions per tick
instance_scheduler_max_actions_per_tick = 200

# Auto-discovery (weekly proposal of scheduling candidates)
instance_scheduler_discovery_enabled = true
instance_scheduler_discovery_cron    = "0 9 ? * SUN *"

# --- FinOps KPI emission ----------------------------------------------------
finops_metrics_enabled             = true
finops_metrics_allocation_tag_keys = ["CostCenter", "BusinessUnit", "Application"]
finops_metrics_aggregator_cron     = "0 7 * * ? *"
finops_metrics_alarm_thresholds = {
  allocation_coverage_min_pct     = 85
  commitment_coverage_min_pct     = 70
  commitment_utilization_min_pct  = 80
  forecast_accuracy_max_drift_pct = 10
}
